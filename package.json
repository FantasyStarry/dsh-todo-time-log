{
  "name": "dsh-todo-time-log",
  "version": "0.5.1",
  "description": "查看待办事项，并记录与展示每个待办的创建时间与完成时间（Todo time log for DeepSeek Harness）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "todo",
    "time-log"
  ],
  "license": "MIT",
  "author": "FantasyStarry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FantasyStarry/dsh-todo-time-log.git"
  },
  "homepage": "https://github.com/FantasyStarry/dsh-todo-time-log#readme",
  "bugs": {
    "url": "https://github.com/FantasyStarry/dsh-todo-time-log/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/files.js",
    "lib/parse.js",
    "lib/store.js",
    "lib/time.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/parse.mjs && node test/smoke.mjs && node test/http.mjs",
    "check": "node --check lib/time.js && node --check lib/parse.js && node --check lib/files.js && node --check lib/store.js && node --check lib/index.js && node --check lib/client.js",
    "audit": "node test/client-audit.mjs",
    "prepublishOnly": "npm run check && npm test && npm run audit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
